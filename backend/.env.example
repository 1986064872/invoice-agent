# ============ 企业智能票据记账助手 —— 后端环境变量 ============
# 用法：把本文件复制为 backend/.env 后填写。
# 注意：.env 里含密钥，不要提交到代码仓库（已在 .gitignore 中忽略）。

# ---------- OCR 供应商 ----------
# local = 本地文本层解析（零成本，只对「有文本层的 PDF」有效）
# baidu = 百度智能云增值税发票识别（需下面两个密钥）
# auto  = 有密钥走百度，没有就回落本地（默认）
OCR_PROVIDER=auto

# 百度智能云 OCR 应用的 API Key / Secret Key
# 获取：https://console.bce.baidu.com/ai/#/ai/ocr/app/list
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# 服务端每日 OCR 调用上限，防止意外产生费用
DAILY_OCR_LIMIT=200

# 低于该分数视为「低置信字段」，复核工作台会黄色高亮
CONFIDENCE_THRESHOLD=0.85

# ---------- 上传限制 ----------
# DeepSeek 可在 Agent 工作台填写；环境变量为可选的服务端密钥来源。
# 配置后仍需在页面勾选启用云端对话。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=120

# ---------- 上传限制 ----------
MAX_FILE_SIZE_MB=20
MAX_BATCH_FILES=50

# ---------- 跨域 ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
